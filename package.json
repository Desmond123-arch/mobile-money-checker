{
  "name": "momo-spend",
  "version": "0.1.0",
  "private": true,
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start --dev-client --scheme momospend",
    "start:go": "expo start --go --scheme momospend",
    "android": "expo start --android --dev-client --scheme momospend",
    "android:local": "expo run:android",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check:sms": "node --no-warnings --import ./scripts/lib/register.mjs scripts/real-data-check.ts",
    "anonymise:sms": "node --no-warnings --import ./scripts/lib/register.mjs scripts/anonymise-sms.ts",
    "test": "jest",
    "check": "npm run typecheck && npm run lint && npm run format:check && npm run test:ci",
    "prepare": "lefthook install",
    "test:ci": "jest --ci --coverage",
    "e2e": "maestro test maestro",
    "doctor": "eas doctor",
    "doctor:expo": "npx expo-doctor",
    "build:dev": "eas build -p android --profile development",
    "build:dev:local": "eas build --local -p android --profile development",
    "build:preview": "eas build -p android --profile preview",
    "build:prod": "eas build -p android --profile production",
    "build:prod:local": "eas build --local -p android --profile production",
    "submit:android": "eas submit -p android"
  },
  "dependencies": {
    "@expo-google-fonts/inter": "^0.4.2",
    "@expo-google-fonts/inter-tight": "^0.4.2",
    "@tanstack/react-query": "^5.104.5",
    "expo": "~58.0.16",
    "expo-build-properties": "~58.0.11",
    "expo-clipboard": "~58.0.3",
    "expo-constants": "~58.0.12",
    "expo-dev-client": "~58.0.14",
    "expo-font": "~58.0.9",
    "expo-linking": "~58.0.13",
    "expo-router": "~58.0.24",
    "expo-splash-screen": "~58.0.10",
    "expo-sqlite": "~58.0.13",
    "expo-status-bar": "~58.0.3",
    "expo-system-ui": "~58.0.6",
    "nativewind": "4.2.7",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-native": "0.88.0",
    "react-native-reanimated": "4.7.1",
    "react-native-safe-area-context": "~5.10.1",
    "react-native-screens": "~4.30.0",
    "react-native-svg": "15.16.0",
    "react-native-worklets": "0.13.0"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.4",
    "@commitlint/config-conventional": "^21.2.4",
    "@types/jest": "^30.0.0",
    "@types/node": "^26.6.5",
    "@types/react": "~19.3.0",
    "babel-preset-expo": "~58.0.0",
    "eslint": "^9.39.5",
    "eslint-config-expo": "^58.0.4",
    "jest": "^30.5.2",
    "lefthook": "^2.2.2",
    "prettier": "^3.9.10",
    "prettier-plugin-tailwindcss": "^0.5.14",
    "tailwindcss": "^3.4.19",
    "ts-jest": "^29.4.15",
    "typescript": "~6.0.3"
  }
}
